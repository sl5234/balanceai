{
  "expo": {
    "name": "BalanceAI",
    "slug": "balanceai",
    "version": "1.0.0",
    "scheme": "balanceai",
    "orientation": "portrait",
    "icon": "./src/balanceai_frontend/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/balanceai_frontend/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3f2f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.balanceai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/balanceai_frontend/assets/adaptive-icon.png",
        "backgroundColor": "#f3f2f2"
      },
      "package": "com.balanceai.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/balanceai_frontend/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
